# Copy to .env.local for development.
# On Vercel, set these in Project → Settings → Environment Variables and mark
# secrets as "Sensitive".

# --- Database -----------------------------------------------------------------
# Postgres connection string. Required.
# - Local: the embedded Postgres from `npm run db:local` (the value below).
# - Vercel: injected automatically by the Marketplace Neon integration.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/archos

# --- Better Auth --------------------------------------------------------------
# openssl rand -base64 32   (required in production)
BETTER_AUTH_SECRET=
# Public origin of the app. Optional on Vercel (VERCEL_URL is used); set to the
# production domain once you have one, e.g. https://app.oxarca.org
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated emails that are promoted to the `admin` role when they sign up.
ADMIN_EMAILS=admin@example.com

# Comma-separated email domains allowed to sign up (leave empty to allow any).
# Example: ox.ac.uk,history.ox.ac.uk
ALLOWED_EMAIL_DOMAINS=

# Google sign-in (optional). Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Key vault ----------------------------------------------------------------
# Master key that encrypts users' OpenAI and Anthropic keys (AES-256-GCM).
# 32 random bytes:  openssl rand -base64 32
# Use a different value on every machine and Vercel environment, and never reuse
# BETTER_AUTH_SECRET. If it is lost, every saved key must be entered again.
KEY_ENCRYPTION_KEY_V1=

# Development only: send key checks to a local stand-in instead of OpenAI and
# Anthropic. Ignored in production.
# KEY_CHECK_BASE_URL=http://127.0.0.1:4010
