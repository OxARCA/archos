# Copy to .env.local for development.
# On Vercel, set these in Project → Settings → Environment Variables and mark
# secrets as "Sensitive".

# --- Database -----------------------------------------------------------------
# Postgres connection string. Required.
# - Local: the embedded Postgres from `npm run db:local` (the value below).
# - Vercel: injected automatically by the Marketplace Neon integration.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/archos

# --- Better Auth --------------------------------------------------------------
# openssl rand -base64 32   (required in production)
BETTER_AUTH_SECRET=
# Public origin of the app. Optional on Vercel (VERCEL_URL is used); set to the
# production domain once you have one, e.g. https://app.oxarca.org
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated emails that are promoted to the `admin` role when they sign up.
ADMIN_EMAILS=admin@example.com

# Sign-up is by invitation: comma-separated email addresses that may create an
# account, besides everyone in ADMIN_EMAILS. Empty means only admins can sign up.
# researcher@example.com is the smoke test's account (npm run test:smoke).
ALLOWED_EMAILS=researcher@example.com

# Open registration: `true` also lets anyone at ALLOWED_EMAIL_DOMAINS sign up
# without an invitation. Off unless set to `true`. Keep it off until sign-up
# emails are verified: until then anyone can type an address at an allowed domain.
OPEN_REGISTRATION=false
# Comma-separated domains for open registration; each covers its subdomains too
# (ox.ac.uk covers history.ox.ac.uk). Ignored while OPEN_REGISTRATION is off.
# Sign-up never opens to everyone: if this is empty, it stays invitation-only.
ALLOWED_EMAIL_DOMAINS=

# --- Budgets --------------------------------------------------------------------
# Optional team-wide monthly limit in US dollars, across everyone on the team
# model key, e.g. 200. Each person is also held to the cap an admin sets for
# them. Leave empty for no team-wide limit.
TEAM_MONTHLY_USD_CAP=
